APP_NAME="Easy Gold Feedback"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3303
DB_DATABASE=easy_gold_feedback
DB_USERNAME=root
DB_PASSWORD=
DB_COLLATION=utf8mb4_0900_bin
# Folder containing mysql and mysqldump for the backup/restore test; empty uses PATH.
MYSQL_CLIENT_BIN=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Internal API accepts only service tokens matching these SHA-256 hashes. No defaults.
FEEDBACK_APP_TOKEN_SHA256=
FEEDBACK_COHORT_TOKEN_SHA256=
# local enables development login only; production intentionally fails closed until SSO is integrated.
FEEDBACK_STAFF_AUTH=disabled
# Local preview default, not a confirmed business language choice: en or lo.
FEEDBACK_UI_LOCALE=en

# Optional explicit local admin provisioning; no default credentials.
# Clear these values after provisioning. Existing accounts are never reset by the seeder.
FEEDBACK_LOCAL_ADMIN_EMAIL=
FEEDBACK_LOCAL_ADMIN_PASSWORD=
